# =============================================================================
# Framing Attack - API Keys
# Copy this file to .env and fill in your keys.
# All APIs below have free tiers.
# =============================================================================

# Google Gemini API (https://aistudio.google.com/apikey)
# Free tier: 15 RPM / 1M tokens per day on Flash models
GEMINI_API_KEY=your-gemini-api-key-here

# Groq API (https://console.groq.com/keys)
# Free tier: 30 RPM on most models
GROQ_API_KEY=your-groq-api-key-here

# OpenAI API (https://platform.openai.com/api-keys) — set a hard monthly budget in Settings > Limits
OPENAI_API_KEY=your-openai-api-key-here

# OpenRouter (https://openrouter.ai/keys) — prepaid credits act as a hard cap
OPENROUTER_API_KEY=your-openrouter-api-key-here

# HuggingFace token (optional, for gated models)
# https://huggingface.co/settings/tokens
HF_TOKEN=your-hf-token-here
